{
  "name": "airport-shuttle", "version": "1.0.0", "private": true,
  "engines": {"node": ">=22.12.0 <25"},
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "start:background": "node scripts/start.mjs --background",
    "stop": "node scripts/stop.mjs",
    "test": "node scripts/reset-test.mjs && playwright test",
    "test:backend": "node scripts/test-backend.mjs",
    "dev:passenger": "ng serve passenger --port 4200 --proxy-config proxy.json",
    "dev:dispatcher": "ng serve dispatcher --port 4201 --proxy-config proxy.json",
    "dev:driver": "ng serve driver --port 4202 --proxy-config proxy.json"
  },
  "dependencies": {
    "@angular/common": "20.3.30", "@angular/compiler": "20.3.30", "@angular/core": "20.3.30",
    "@angular/forms": "20.3.30", "@angular/platform-browser": "20.3.30", "@angular/router": "20.3.30",
    "@ionic/angular": "8.8.19", "ionicons": "7.4.0", "leaflet": "1.9.4", "rxjs": "7.8.2", "tslib": "2.8.1", "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.36", "@angular/cli": "20.3.36", "@angular/compiler-cli": "20.3.30",
    "@playwright/test": "1.58.2", "@types/leaflet": "1.9.21", "typescript": "5.9.3"
  }
}
