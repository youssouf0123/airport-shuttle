{
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "passenger": {
      "projectType": "application",
      "root": "passenger-ui",
      "sourceRoot": "passenger-ui/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/passenger",
              "browser": ""
            },
            "index": "passenger-ui/src/index.html",
            "browser": "passenger-ui/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "passenger-ui/tsconfig.app.json",
            "styles": [
              "shared/styles.css"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "/"
              }
            ],
            "baseHref": "/passenger/",
            "allowedCommonJsDependencies": [
              "leaflet"
            ],
            "budgets": [
              {
                "type": "initial",
                "maximumWarning": "2mb",
                "maximumError": "3mb"
              }
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "passenger:build"
          }
        }
      }
    },
    "dispatcher": {
